<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The executable is `Orion`: Orion.app's CFBundleExecutable, and the sibling the bundled orion-mcp runs (#310). -->
    <AssemblyName>Orion</AssemblyName>
    <!-- UTF-8 as the process code page on Windows, for every char* path the engine opens (#376). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Orion.exe's icon in Explorer, the taskbar and the Start menu (decision #407). -->
    <ApplicationIcon>../brand/windows/orion.ico</ApplicationIcon>
    <RootNamespace>OrionShell</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- packages.lock.json pins every transitive package, the terminal's native pty above all (#366). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Every package's publish (tools/package-*.sh, each with a runtime) ships native code beside the IL,
         so a launch does not JIT the window first; `dotnet build` ignores it. tools/package-gates.py refuses a package without it. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built by native/build.sh from the engine's static library on macOS; on Windows and
         Linux by native/CMakeLists.txt, and the workflow copies it beside the app (#376). -->
    <None Include="bin-native/liborion_shim.dylib" Link="liborion_shim.dylib" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('bin-native/liborion_shim.dylib')" />
    <!-- The numeral face (Shared/Design/Type.cs) and the SIL OFL 1.1 it travels with. -->
    <AvaloniaResource Include="Assets/Fonts/**" />
    <!-- Orion's mark as the brand made it (decision #407): Shared/BrandArt.cs draws these
         from the assembly, and the window icon is the brand's PNG or ICO, never a redraw. -->
    <EmbeddedResource Include="../brand/app/*.svg" LogicalName="brand/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../brand/linux/hicolor/256x256/apps/orion.png" LogicalName="brand/window-icon.png" />
    <EmbeddedResource Include="../brand/windows/orion.ico" LogicalName="brand/window-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="[4.1.0]" />
    <!-- Installers and updates from GitHub Releases (#389). MIT. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
