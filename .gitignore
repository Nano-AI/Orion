# --- Test images -----------------------------------------------------------
# RAW files are 25-60 MB each. Never commit them; keep a local test/ folder.
*.ARW
*.arw
*.CR2
*.CR3
*.NEF
*.RAF
*.DNG
*.dng
*.ORF
*.RW2
test-images/
samples/

# --- Bench and harness output ----------------------------------------------
# apps/bench writes full-resolution renders beside itself so you can look at
# them. They are 45-70 MB each, and `git add -A` swept 190 MB of them into two
# commits, which is why a push started dying mid-transfer.
orion-*.png
orion-*.jpg
orion-*.jpeg
orion-*.tif
orion-*.tiff

# --- Build -----------------------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
install/
out/

# --- Xcode -----------------------------------------------------------------
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside

# --- Swift -----------------------------------------------------------------
.build/
.swiftpm/

# --- Compiled shaders ------------------------------------------------------
*.metallib
*.air
*.spv

# --- Generated / runtime ---------------------------------------------------
# SQLite index is a disposable cache, rebuilt from XMP sidecars
*.db
*.sqlite
*.sqlite3
thumbnail-cache/

# --- Third-party -----------------------------------------------------------
vendor/
third_party/*/
!third_party/CMakeLists.txt

# --- macOS -----------------------------------------------------------------
.DS_Store
.AppleDouble
._*

# --- Editors ---------------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Render output --------------------------------------------------------
orion-out.png
*-out.png

# Sample RAW files — large, and the developer's own photos
Samples/

# --- The landing site's screenshots -----------------------------------------
# The orion-*.jpg rule above exists for full-resolution bench renders at the
# repo root. It also matched web/img/orion-mask-*.jpg, so `git add web` skipped
# them without a word and the site deployed with every image 404ing — a push
# that reported success and a page that was visibly broken.
!web/img/orion-*.jpg
